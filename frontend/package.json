{
  "name": "frontend",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "version:generate": "node scripts/generate-version.mjs",
    "start": "ng serve",
    "start:en": "ng serve --configuration en",
    "start:languages": "node scripts/serve.mjs",
    "prebuild": "npm run version:generate",
    "build": "ng build",
    "i18n": "ng extract-i18n && node scripts/check-i18n.mjs",
    "watch": "ng build --watch --configuration development"
  },
  "private": true,
  "packageManager": "npm@11.4.1",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@primeuix/themes": "^2.0.3",
    "angularx-qrcode": "^21.0.5",
    "chart.js": "^4.5.1",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.18",
    "@angular/cli": "^21.2.18",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/localize": "^21.2.25",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
