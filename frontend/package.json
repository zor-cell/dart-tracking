{
  "name": "frontend",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "version:generate": "node scripts/generate-version.mjs",
    "license:generate": "node scripts/generate-license.mjs",
    "postinstall": "npm run license:generate",
    "start": "ng serve",
    "start:en": "ng serve --configuration en",
    "start:languages": "node scripts/serve.mjs",
    "prebuild": "npm run version:generate && npm run license:generate",
    "build": "ng build",
    "i18n": "ng extract-i18n && node scripts/check-i18n.mjs",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "watch": "ng build --watch --configuration development"
  },
  "private": true,
  "packageManager": "npm@11.4.1",
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@primeuix/themes": "^3.1.1",
    "angularx-qrcode": "^22.0.1",
    "chart.js": "^4.5.1",
    "primeicons": "^7.0.0",
    "primeng": "^22.1.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/localize": "^22.2.6",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "glob": "14.0.4",
    "minimatch": "11.0.6",
    "undici": "7.30.1"
  }
}
